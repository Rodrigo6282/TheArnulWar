; Engine configuration file.
; The Arnul War (Godot 4.7)

config_version=5

[application]

config/name="The Arnul War"
config/description="Shooter en primera persona"
config/version="1.5.2"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"
boot_splash/bg_color=Color(0.06, 0.07, 0.07, 1)

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[audio]

driver/enable_input=true

[physics]

3d/physics_engine="Jolt Physics"

[shader_globals]

wetness={
"type": "float",
"value": 0.0
}
snow_cover={
"type": "float",
"value": 0.0
}

[rendering]

renderer/rendering_method="forward_plus"
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=2
anti_aliasing/quality/msaa_3d=1
